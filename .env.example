# Our own convention, not an IFM-published contract. See docs/PAN_ACCESS.md.
# Copy to .env (git-ignored) and fill in. Never commit real values.

# Secret. PAN credential. Leave empty to run the mock backend.
PAN_API_KEY=

# Base URL of the PAN endpoint. No verified endpoint exists yet — do not guess one.
PAN_BASE_URL=

# Model / deployment identifier, if the real interface takes one.
PAN_MODEL=

# Per-request timeout in seconds, so PAN latency never blocks the packing solver.
PAN_TIMEOUT_S=120

# Path appended to PAN_BASE_URL for the simulate call (e.g. /v1/simulate). Unset means unconfigured.
PAN_ENDPOINT_PATH=

# Same PAN credential, read directly by physics/pan.py; demo_e2e.py falls back to PAN_API_KEY if unset.
IFM_API_KEY=

# --- Grok + Claude (server-side photo labelling) ---
# Either or both may be set. With both, Claude's answer wins when they name the item differently.
# With neither, and when every configured model declines, the item's labelStatus becomes the
# terminal "unidentified" instead of "unknown"/"done" (SCAN_OUTPUT.md).

# Secret. xAI Grok key. Unset means Grok is skipped.
XAI_API_KEY=

# Grok model id used for labelling. Default: grok-4
GROK_MODEL=

# Secret. Anthropic key. Unset means Claude is skipped.
ANTHROPIC_API_KEY=

# Claude model id used for labelling. Default: claude-sonnet-5
ANTHROPIC_MODEL=

# --- Mongo (server storage) ---

# Mongo connection string for the server. Default: mongodb://localhost:27017
SUITCASE_MONGODB_URI=

# Mongo database name. Default: suitcase
MONGO_DB=

# Seconds between label retry sweeps. Default: 10
LABEL_RETRY_S=

# Attempts before a photo's labelling is given up on ("failed"). Default: 5
LABEL_MAX_ATTEMPTS=

# Auth0 tenant domain (e.g. your-tenant.us.auth0.com), no scheme/path. No tenant exists yet.
AUTH0_DOMAIN=

# Auth0 API identifier this server expects in the token's "aud" claim. No tenant exists yet.
AUTH0_AUDIENCE=

# Not a .env var: PACKAR_SERVER is an Xcode scheme environment variable read by Spike/API.swift.
# Default when unset: http://172.26.48.172:8000
